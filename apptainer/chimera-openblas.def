Bootstrap: docker
From: ubuntu:24.04

%environment
    export VIRTUAL_ENV="/app/openblas/venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"
    export PYTHONNOUSERSITE=1
    export PYTHONPATH="$VIRTUAL_ENV/lib/python3.12/site-packages"
    export LD_LIBRARY_PATH="/opt/OpenBLAS/lib:/usr/local/lib:$LD_LIBRARY_PATH"
    export PKG_CONFIG_PATH="/opt/OpenBLAS/lib/pkgconfig:/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH"

%files
    apptainer/install_chimera_backend.sh /app/install_chimera_backend.sh

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ccache \
        cmake \
        curl \
        g++ \
        gcc \
        gfortran \
        git \
        llvm \
        make \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ca-certificates \
        libssl-dev \
        libffi-dev \
        zlib1g-dev \
        libjpeg-dev \
        libpng-dev \
        libopenmpi-dev \
        openmpi-bin \
        libprotobuf-dev \
        protobuf-compiler \
        libgflags-dev \
        libgoogle-glog-dev \
        && rm -rf /var/lib/apt/lists/*

    chmod 0755 /app/install_chimera_backend.sh
    mkdir -p /app/openblas
    cd /app/openblas
    MAX_JOBS="${MAX_JOBS:-8}" bash /app/install_chimera_backend.sh openblas
    ldconfig
